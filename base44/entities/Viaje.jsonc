{
  "name": "Viaje",
  "type": "object",
  "properties": {
    "camion_id": {
      "type": "string"
    },
    "chofer_nombre": {
      "type": "string"
    },
    "chofer_id": {
      "type": "string"
    },
    "usuario_id": {
      "type": "string"
    },
    "usuario_nombre": {
      "type": "string"
    },
    "origen_lat": {
      "type": "number"
    },
    "origen_lng": {
      "type": "number"
    },
    "destino_lat": {
      "type": "number"
    },
    "destino_lng": {
      "type": "number"
    },
    "distancia_km": {
      "type": "number"
    },
    "toneladas": {
      "type": "number"
    },
    "tipo_tarifa": {
      "type": "string",
      "enum": [
        "por_km",
        "por_tonelada"
      ],
      "default": "por_km"
    },
    "precio": {
      "type": "number"
    },
    "carga": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "solicitado",
        "aceptado",
        "en_camino",
        "completado",
        "cancelado"
      ],
      "default": "solicitado"
    }
  },
  "required": [
    "origen_lat",
    "origen_lng",
    "destino_lat",
    "destino_lng",
    "distancia_km",
    "precio",
    "carga"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        { "data.usuario_id": "{{user.id}}" },
        { "data.chofer_id": "{{user.id}}" },
        { "data.estado": "solicitado" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}