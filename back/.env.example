# Environment
NODE_ENV=development

# Server
PORT=3000
API_URL=http://localhost:3000

# Frontend
FRONTEND_URL=http://localhost:5173

# Database
# With docker-compose (recommended), Postgres is published on host port 5434.
DB_HOST=localhost
DB_PORT=5434
DB_NAME=nexvia_db
DB_USER=nexvia_user
DB_PASSWORD=nexvia_pass

# Redis (optional, for sessions + rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# Session
SESSION_SECRET=your_super_secret_session_key_change_in_production

# JWT (if using JWT alongside cookies)
JWT_SECRET=your_jwt_secret_key

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@nexvia.app

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# File Storage (S3 or local)
STORAGE_TYPE=local
STORAGE_BUCKET=nexvia-files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
